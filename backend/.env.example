# Copy to .env and fill in. .env holds live credentials and is never committed.

COUCHDB_URL=http://user:password@localhost:5984/
COUCHDB_RAW_DATABASE=skypulse
COUCHDB_DENOISED_DATABASE=skypulse-denoised
COUCHDB_NODES_DATABASE=skypulse-nodes

# Leave MONGODB_URI empty to run against CouchDB alone — the Atlas mirror
# switches itself off when it is unset.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DATABASE=skypulse
MONGODB_RAW_COLLECTION=raw_telemetry
MONGODB_PREPROCESSED_COLLECTION=preprocessed_telemetry

# ==========================================================
# MQTT ingest — Node-RED publishes telemetry to Mosquitto
# ==========================================================
# The backend subscribes as a durable client, so packets published while it is
# restarting are queued by the broker and delivered when it comes back.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=skypulse/telemetry

# QoS 1 is at-least-once: the broker redelivers until we acknowledge. Combined
# with the fixed client id below it is what survives a backend restart.
MQTT_QOS=1

# Must be unique per backend instance. Two instances sharing an id fight over
# the same session and keep kicking each other off the broker.
MQTT_CLIENT_ID=skypulse-backend
MQTT_KEEPALIVE=60

# Only if Mosquitto has allow_anonymous false.
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to false to run on HTTP ingest alone — /api/telemetry keeps working
# either way.
MQTT_ENABLED=true

# ==========================================================
# Authentication — your Supabase project
# ==========================================================
# Accounts live in Supabase Auth (auth.users) plus the public.profiles table.
# Run backend/app/authentification/schema.sql once in the Supabase SQL editor
# before the first sign-in.
#
# Dashboard -> Project Settings -> API keys
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable / anon key (sb_publishable_... or the legacy anon JWT).
# Safe to expose; used for sign up, sign in and refresh.
SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role key (sb_secret_... or the legacy service_role JWT).
# Bypasses Row Level Security — needed to read roles and to administer accounts.
# NEVER put this in the frontend.
SUPABASE_SECRET_KEY=

# Only for projects still on the legacy shared HS256 JWT secret. Projects with
# asymmetric signing keys (the current default) leave this empty — the backend
# verifies tokens against the public JWKS instead.
SUPABASE_JWT_SECRET=

# Where Supabase sends people after they click a confirmation or reset link.
# Both must be listed under Authentication -> URL Configuration -> Redirect URLs.
AUTH_EMAIL_REDIRECT_URL=http://localhost:5173/dashboard
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/auth

# Mirrors the minimum length set in Authentication -> Providers -> Email, so the
# API can reject a short password with a clear message.
AUTH_PASSWORD_MIN_LENGTH=8

# Session cookies. Secure must be true anywhere the app is served over https,
# and must stay false for http://localhost or the browser drops the cookie.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
