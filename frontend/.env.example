# Copy to .env. The frontend holds no auth secrets of its own — accounts,
# passwords and sessions all live in the FastAPI backend
# (backend/app/authentification), and the browser only ever carries the
# httpOnly session cookies the backend sets.

# Base URL for the FastAPI backend, used by the browser. Leave empty to go
# through the vite /api proxy from vite.config.ts during local development —
# which also keeps the session cookies same-origin, so they are sent
# automatically.
VITE_TELEMETRY_API_BASE_URL=""

# The same backend, as reached from the SSR server rather than the browser.
# src/lib/auth.middleware.ts calls /api/auth/me through it to authorise server
# functions, and server-side fetch needs an absolute URL.
TELEMETRY_API_BASE_URL="http://127.0.0.1:8000"

# Server-side key for the AI copilot gateway (src/lib/ai.functions.ts).
LOVABLE_API_KEY=""
