# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
# Use the anon / publishable key only — never the service_role key, which reaches the browser.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL="https://<project-id>.supabase.co"

# Local dev only: set to "true" to skip the Supabase auth gate on /dashboard.
# Must stay unset (or "false") anywhere the app is deployed.
VITE_DISABLE_AUTH="false"

# Base URL for the FastAPI telemetry backend. Leave empty to use the vite /api
# proxy from vite.config.ts during local development.
VITE_TELEMETRY_API_BASE_URL=""
